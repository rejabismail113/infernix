APP_NAME="Infernix Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8010
# Host port published for the app container (the container itself listens on 8000). Change if 8010 is taken.
APP_PORT=8010
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 is the single authoritative transactional DB (SRS §6.2).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=infernix
DB_USERNAME=infernix
DB_PASSWORD=infernix

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=documents
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=infernix

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit in dev; SMTP provider in production (docs/DECISIONS.md D-09).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@infernix.local"
MAIL_FROM_NAME="${APP_NAME}"

# Private S3-compatible object storage for ALL attachments (RustFS in dev — S3 API; MinIO images left Docker Hub). Never /public.
AWS_ACCESS_KEY_ID=infernix
AWS_SECRET_ACCESS_KEY=infernix-minio-secret
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=infernix-documents
AWS_ENDPOINT=http://objectstore:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Seeded Owner login (dev only). Change in production.
SEED_OWNER_EMAIL=owner@infernix.local
SEED_OWNER_PASSWORD=ChangeMe-Infernix-2026!
# Shared password of the dev / UAT demo users created by `make demo` (UatDemoSeeder refuses production)
SEED_DEMO_PASSWORD=Demo-Infernix-2026!
SEED_OWNER_NAME=Julaiha

# Secret-sentinel used ONLY by dev/test leak tests (UAT-08). Must never be a real credential.
SECRET_SENTINEL=SENTINEL-DO-NOT-LEAK-9f3a7c1e

# Vault: null | fake (dev/test only) | bitwarden | onepassword — real drivers also need FEATURE_VAULT=true (docs/DECISIONS.md D-05, A-74)
VAULT_DRIVER=fake
FEATURE_VAULT=false
# Antivirus: null | clamav
DOCUMENT_SCANNER=null

# PDF rendering: browsershot (headless Chromium) with dompdf fallback
PDF_DRIVER=browsershot
CHROME_PATH=/usr/bin/chromium
NODE_BINARY=/usr/bin/node
NPM_BINARY=/usr/bin/npm

# Feature flags (all off by default; see docs/DECISIONS.md)
FEATURE_MYINVOIS=false
FEATURE_DEPRECIATION_POSTING=false

VITE_APP_NAME="${APP_NAME}"

# Backups (NFR-06): BACKUP_DISK=backups (private S3 bucket) in production; passphrase from the secret store only.
BACKUP_DISK=backups_local
BACKUP_PASSPHRASE=
BACKUP_BUCKET=infernix-backups
# Observability (NFR-10)
LOG_REQUESTS=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_RELEASE=v1.0.0-rc1
# e-Invoice (§6.2) — FEATURE_MYINVOIS above stays false until the accountant confirms obligations
EINVOICE_SUPPLIER_TIN=
